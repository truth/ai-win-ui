<Panel direction="row" spacing="0" padding="0,0,0,0" background="#FFFFFF" alignItems="center" height="54" borderBottom="1,#F1F5F9">
  <!-- Avatar -->
  <Panel width="34" height="34" marginLeft="4" cornerRadius="17" background="#F1F5F9" justifyContent="center" alignItems="center">
    <Icon name="user" size="15" color="#64748B" strokeWidth="2.0" />
  </Panel>

  <!-- Name & Contact -->
  <Panel direction="column" marginLeft="14" width="230">
    <Label text="Ansh Singh" fontSize="13" color="#0F172A" fontWeight="600" />
    <Label text="9888858585 - ansh@medlio.com" fontSize="11" color="#94A3B8" />
  </Panel>

  <!-- Time -->
  <Panel direction="row" marginLeft="12" alignItems="center" width="84">
    <Icon name="clock" size="13" color="#2764FF" marginRight="5" strokeWidth="2.0" />
    <Label text="14:15" fontSize="12" color="#2764FF" fontWeight="600" />
  </Panel>

  <!-- Date -->
  <Label text="16 Feb 2026" fontSize="12" color="#64748B" width="100" marginLeft="12" />

  <!-- Status Badge: Scheduled -->
  <Panel padding="10,4,10,4" cornerRadius="6" background="#E0E7FF" justifyContent="center" alignItems="center" marginLeft="10">
    <Label text="Scheduled" fontSize="11" color="#3730A3" fontWeight="600" />
  </Panel>

  <Spacer flexGrow="1" />

  <!-- Action buttons -->
  <Button text="Start Session" height="28" padding="12,0,12,0" fontSize="11" background="#EFF6FF" border="1,#BFDBFE" color="#2563EB" cornerRadius="6" marginRight="8" />
  <Button text="EMR" height="28" padding="12,0,12,0" fontSize="11" background="#FFFFFF" border="1,#CBD5E1" color="#475569" cornerRadius="6" marginRight="8" />
</Panel>
